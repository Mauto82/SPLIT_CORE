{
  "canvasId": "projection-canvas",
  "viewport": {
    "width": 960,
    "height": 540
  },
  "rendering": {
    "backend": "terminal",
    "backgroundColor": "#000000",
    "pointColor": "#44d9e6",
    "pointRadius": 3,
    "terminal": {
      "elementId": "projection-terminal",
      "columns": 140,
      "rows": 52,
      "fontSizePx": 9,
      "lineHeight": 1,
      "emptyChar": " ",
      "depthShades": " .:-=+*#%@",
      "depthRange": {
        "near": -4,
        "far": 4
      },
      "console": {
        "enabled": true,
        "containerElementId": "engine-console",
        "screenElementId": "engine-console-output",
        "inputElementId": "engine-console-input",
        "prompt": "engine",
        "promptSeparator": " > ",
        "maxLines": 14,
        "historySize": 64,
        "autocompleteEnabled": true,
        "perspective": {
          "focalLength": 2.8,
          "cameraDistance": 1.6,
          "vanishingPointX": 0.5,
          "vanishingPointY": 0.1,
          "nearZ": 0,
          "depthStep": 0.22,
          "maxDepth": 20,
          "nearOpacity": 1,
          "farOpacity": 0.02,
          "blurMaxPx": 2.8,
          "nearScale": 1,
          "lineGapY": 0.028,
          "baseX": 0.035,
          "baseY": 0.9
        },
        "welcomeLines": [
          "P0 KERNEL PANIC RECOVERY MODE",
          "Filesystem mounted read-only.",
          "User 'guest' logged in with restricted privileges.",
          "Type 'help' for available commands."
        ],
        "commands": {
          "help": "help",
          "pause": "pause",
          "resume": "resume",
          "speed": "speed",
          "status": "status",
          "reset": "reset",
          "projection": "projection"
        },
        "messages": {
          "help": "Comandi disponibili: help | status | pause | resume | speed <valore positivo> | reset | projection <on|off>",
          "paused": "Loop in pausa",
          "resumed": "Loop ripreso",
          "reset": "Runtime e animazione resettati",
          "statusPrefix": "Stato",
          "runningToken": "running",
          "pausedToken": "paused",
          "speedToken": "speed",
          "shapesToken": "shapes",
          "projectionToken": "projection",
          "speedUpdatedPrefix": "Speed aggiornata",
          "projectionUpdatedPrefix": "Projection aggiornata",
          "invalidSpeedValue": "Valore speed non valido",
          "invalidProjectionValue": "Valore projection non valido (usa on/off)",
          "unknownCommandPrefix": "Comando sconosciuto"
        }
      }
    }
  },
  "projection": {
    "enabled": false,
    "focalLength": 280,
    "cameraDistance": 6
  },
  "scene": {
    "shapes": [
      {
        "id": "shape-cube",
        "type": "cube",
        "size": 1.2,
        "rotationSpeed": {
          "x": 0.009,
          "y": 0.012,
          "z": 0.006
        },
        "offset": {
          "x": -2.2,
          "y": 0,
          "z": 0
        }
      },
      {
        "id": "shape-tetra",
        "type": "tetrahedron",
        "size": 1.5,
        "rotationSpeed": {
          "x": 0.013,
          "y": 0.007,
          "z": 0.011
        },
        "offset": {
          "x": 0,
          "y": 0,
          "z": 0
        }
      },
      {
        "id": "shape-octa",
        "type": "octahedron",
        "size": 1.6,
        "rotationSpeed": {
          "x": 0.008,
          "y": 0.014,
          "z": 0.01
        },
        "offset": {
          "x": 2.2,
          "y": 0,
          "z": 0
        }
      },
      {
        "id": "shape-prism",
        "type": "prism",
        "size": 1.3,
        "rotationSpeed": {
          "x": 0.01,
          "y": 0.01,
          "z": 0.015
        },
        "offset": {
          "x": 0,
          "y": -2,
          "z": 0
        }
      }
    ]
  },
  "loop": {
    "frameRate": 60,
    "startPaused": false
  }
}
