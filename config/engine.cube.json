{
  "canvasId": "projection-canvas",
  "viewport": {
    "width": 960,
    "height": 540
  },
  "rendering": {
    "backend": "terminal",
    "backgroundColor": "#000000",
    "pointColor": "#44d9e6",
    "pointRadius": 3,
    "terminal": {
      "elementId": "projection-terminal",
      "columns": 140,
      "rows": 52,
      "fontSizePx": 9,
      "lineHeight": 1,
      "emptyChar": " ",
      "depthShades": " .:-=+*#%@",
      "depthRange": {
        "near": -4,
        "far": 4
      },
      "console": {
        "enabled": true,
        "containerElementId": "engine-console",
        "screenElementId": "engine-console-output",
        "inputElementId": "engine-console-input",
        "prompt": "engine",
        "promptSeparator": " > ",
        "maxLines": 14,
        "historySize": 64,
        "autocompleteEnabled": true,
        "welcomeLines": [
          "Terminale motore attivo",
          "Comandi: help, status, pause, resume, speed <valore>, reset"
        ],
        "commands": {
          "help": "help",
          "pause": "pause",
          "resume": "resume",
          "speed": "speed",
          "status": "status",
          "reset": "reset"
        },
        "messages": {
          "help": "Comandi disponibili: help | status | pause | resume | speed <valore positivo> | reset",
          "paused": "Loop in pausa",
          "resumed": "Loop ripreso",
          "reset": "Runtime e animazione resettati",
          "statusPrefix": "Stato",
          "runningToken": "running",
          "pausedToken": "paused",
          "speedToken": "speed",
          "shapesToken": "shapes",
          "speedUpdatedPrefix": "Speed aggiornata",
          "invalidSpeedValue": "Valore speed non valido",
          "unknownCommandPrefix": "Comando sconosciuto"
        }
      }
    }
  },
  "projection": {
    "focalLength": 280,
    "cameraDistance": 6
  },
  "scene": {
    "shapes": [
      {
        "id": "shape-cube",
        "type": "cube",
        "size": 1.2,
        "rotationSpeed": {
          "x": 0.009,
          "y": 0.012,
          "z": 0.006
        },
        "offset": {
          "x": 0,
          "y": 0,
          "z": 0
        }
      }
    ]
  },
  "loop": {
    "frameRate": 30,
    "startPaused": false
  }
}
